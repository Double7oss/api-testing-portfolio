        "exec": [
          "pm.test('Response time is below 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
          "pm.test('Response has JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
