  "item": [
    {
      "name": "Posts - Read and Query",
      "item": [
        {
          "name": "TC-001 Get all posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Exactly 100 posts are returned', () => pm.expect(pm.response.json()).to.have.lengthOf(100));",
                  "pm.test('Post contract is valid', () => pm.response.json().forEach(p => { pm.expect(p).to.have.all.keys('userId','id','title','body'); pm.expect(p.id).to.be.a('number'); pm.expect(p.title).to.be.a('string').and.not.empty; }));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-002 Get an existing post",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/posts/{{post_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Requested post is returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('post_id'))));",
                  "pm.test('Field types are valid', () => { const p=pm.response.json(); pm.expect(p.userId).to.be.a('number'); pm.expect(p.title).to.be.a('string').and.not.empty; pm.expect(p.body).to.be.a('string').and.not.empty; });"
