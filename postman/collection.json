    {
      "name": "Posts - Simulated Writes",
      "item": [
        {
          "name": "TC-011 Create a valid post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API testing portfolio\",\n  \"body\": \"Created by an automated test\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('ID and submitted values are returned', () => { const p=pm.response.json(); pm.expect(p.id).to.be.a('number'); pm.expect(p.title).to.eql('API testing portfolio'); pm.expect(p.userId).to.eql(1); });"
                ]
              }
            }
          ]
        },
